{
  "name": "@venom-cowork/workspace-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "VENOMCOWORK_DEV_MODE=1 VENOMCOWORK_ELECTRON_REMOTE_DEBUG_PORT=${VENOMCOWORK_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @venom-cowork/desktop dev",
    "dev:electron": "VENOMCOWORK_DEV_MODE=1 pnpm --filter @venom-cowork/desktop dev:electron",
    "dev:windows": ".\\scripts\\dev-windows.cmd",
    "dev:windows:x64": ".\\scripts\\dev-windows.cmd x64",
    "dev:ui": "VENOMCOWORK_DEV_MODE=1 pnpm --filter @venom-cowork/app dev",
    "dev:ui-demo": "pnpm --filter @venom-cowork/ui-demo dev",
    "dev:web": "pnpm run dev:den:web",
    "dev:web-local": "pnpm run dev:den",
    "dev:den": "node scripts/dev-local.mjs",
    "dev:den-local": "pnpm run dev:den",
    "dev:den:mysql": "docker compose -p venomcowork-den-local -f packaging/docker/docker-compose.web-local.yml up -d --wait mysql",
    "dev:den:mysql:down": "docker compose -p venomcowork-den-local -f packaging/docker/docker-compose.web-local.yml down",
    "dev:den:db-push": "sh -lc 'DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/venomcowork_den} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} pnpm --filter @venom-cowork-ee/den-db db:push'",
    "dev:den:api": "sh -lc 'DEN_WEB_PORT=${DEN_WEB_PORT:-3005}; VENOMCOWORK_APP_PORT=${VENOMCOWORK_APP_PORT:-5173}; DEN_LOCAL_ORIGINS=http://localhost:$DEN_WEB_PORT,http://127.0.0.1:$DEN_WEB_PORT,http://localhost:$VENOMCOWORK_APP_PORT,http://127.0.0.1:$VENOMCOWORK_APP_PORT; VENOMCOWORK_DEV_MODE=1 PORT=${DEN_API_PORT:-8790} DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/venomcowork_den} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-local-dev-secret-not-for-production-use!!} BETTER_AUTH_URL=${BETTER_AUTH_URL:-http://localhost:$DEN_WEB_PORT} DEN_BETTER_AUTH_TRUSTED_ORIGINS=${DEN_BETTER_AUTH_TRUSTED_ORIGINS:-$DEN_LOCAL_ORIGINS} CORS_ORIGINS=${CORS_ORIGINS:-$DEN_LOCAL_ORIGINS} PROVISIONER_MODE=${PROVISIONER_MODE:-stub} pnpm --filter @venom-cowork-ee/den-api dev:local'",
    "dev:den:inference": "sh -lc 'DEN_WEB_PORT=${DEN_WEB_PORT:-3005}; VENOMCOWORK_APP_PORT=${VENOMCOWORK_APP_PORT:-5173}; INFERENCE_PORT=${INFERENCE_PORT:-8791}; DEN_LOCAL_ORIGINS=http://localhost:$DEN_WEB_PORT,http://127.0.0.1:$DEN_WEB_PORT,http://localhost:$VENOMCOWORK_APP_PORT,http://127.0.0.1:$VENOMCOWORK_APP_PORT; VENOMCOWORK_DEV_MODE=1 PORT=$INFERENCE_PORT DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/venomcowork_den} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} CORS_ORIGINS=${CORS_ORIGINS:-$DEN_LOCAL_ORIGINS} INFERENCE_PROXY_BASE_URL=${INFERENCE_PROXY_BASE_URL:-http://localhost:$INFERENCE_PORT} INFERENCE_ADMIN_TOKEN=${INFERENCE_ADMIN_TOKEN:-local-dev-admin-token} INFERENCE_WEBHOOK_SECRET=${INFERENCE_WEBHOOK_SECRET:-local-dev-webhook-secret} pnpm --filter @venom-cowork-ee/inference dev:local'",
    "dev:den:web": "sh -lc 'DEN_API_PORT=${DEN_API_PORT:-8790}; DEN_WEB_PORT=${DEN_WEB_PORT:-3005}; VENOMCOWORK_DEV_MODE=1 NEXT_PUBLIC_POSTHOG_KEY= NEXT_PUBLIC_POSTHOG_API_KEY= DEN_API_BASE=${DEN_API_BASE:-http://localhost:$DEN_API_PORT} DEN_AUTH_ORIGIN=${DEN_AUTH_ORIGIN:-http://localhost:$DEN_WEB_PORT} DEN_AUTH_FALLBACK_BASE=${DEN_AUTH_FALLBACK_BASE:-http://localhost:$DEN_API_PORT} pnpm --filter @venom-cowork-ee/den-web dev:local'",
    "email:dev": "pnpm --filter @venom-cowork/email dev",
    "dev:den:seed-demo": "pnpm --filter @venom-cowork-ee/den-api seed:demo-org",
    "dev:headless-web": "VENOMCOWORK_DEV_MODE=1 bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @venom-cowork/app build",
    "build:web": "pnpm --filter @venom-cowork-ee/den-web build",
    "preview": "pnpm --filter @venom-cowork/app preview",
    "typecheck": "pnpm --filter @venom-cowork/app typecheck",
    "test:health": "pnpm --filter @venom-cowork/app test:health",
    "test:sessions": "pnpm --filter @venom-cowork/app test:sessions",
    "test:refactor": "pnpm --filter @venom-cowork/app test:refactor",
    "test:events": "pnpm --filter @venom-cowork/app test:events",
    "test:todos": "pnpm --filter @venom-cowork/app test:todos",
    "test:permissions": "pnpm --filter @venom-cowork/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @venom-cowork/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @venom-cowork/app test:session-scope",
    "test:session-switch": "pnpm --filter @venom-cowork/app test:session-switch",
    "test:fs-engine": "pnpm --filter @venom-cowork/app test:fs-engine",
    "test:e2e": "pnpm --filter @venom-cowork/app test:e2e",
    "test:orchestrator": "pnpm --filter venomcowork-orchestrator test:router",
    "bump:patch": "pnpm --filter @venom-cowork/app bump:patch",
    "bump:minor": "pnpm --filter @venom-cowork/app bump:minor",
    "bump:major": "pnpm --filter @venom-cowork/app bump:major",
    "bump:set": "pnpm --filter @venom-cowork/app bump:set"
  },
  "devDependencies": {
    "ico-endec": "^0.1.6",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "turbo": "^2.5.5"
  },
  "packageManager": "pnpm@11.4.0",
  "dependencies": {
    "glob": "^13.0.6"
  }
}
