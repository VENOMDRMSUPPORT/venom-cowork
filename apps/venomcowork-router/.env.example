VENOMCOWORK_ENGINE_URL=http://127.0.0.1:4096
VENOMCOWORK_ENGINE_DIRECTORY=
VENOMCOWORK_ENGINE_USERNAME=
VENOMCOWORK_ENGINE_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ENABLED=true

VENOMCOWORK_ROUTER_DATA_DIR=~/.venomcowork/router
VENOMCOWORK_ROUTER_DB_PATH=~/.venomcowork/router/router.db
VENOMCOWORK_ROUTER_CONFIG_PATH=~/.venomcowork/router/router.json
