# Alias for VENOMCOWORK_ROUTER_HEALTH_PORT (optional)
PORT=
TOOL_UPDATES_ENABLED=false
GROUPS_ENABLED=false
TOOL_OUTPUT_LIMIT=1200
PERMISSION_MODE=allow
LOG_LEVEL=info
