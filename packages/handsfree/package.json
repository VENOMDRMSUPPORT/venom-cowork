{
  "name": "@venom-cowork/handsfree",
  "private": true,
  "version": "0.1.0",
  "description": "macOS semantic AX and background computer-use runtime for VenomCowork",
  "license": "MIT",
  "type": "module",
  "bin": {
    "venomcowork-handsfree-computer-use": "bin/venomcowork-handsfree-computer-use.mjs"
  },
  "scripts": {
    "check": "pnpm run check:js && pnpm run check:native",
    "check:js": "node --check bin/venomcowork-handsfree-computer-use.mjs && node --check src/cua-runner.mjs && node --check src/realtime-tools.mjs",
    "build:native": "swift build --package-path native/HandsFree -c release --product HandsFreeComputerUse",
    "check:native": "swift build --package-path native/HandsFree --product HandsFreeComputerUse"
  },
  "files": [
    "bin",
    "src",
    "native",
    "README.md"
  ]
}

