pkgname=venomcowork
pkgver=0.15.1
pkgrel=1 # pkgrel should change when PKGBUILD does. Standard is to change back to 1 next time. Any interger is valid.
pkgdesc="An Open source alternative to Claude Cowork"
arch=('x86_64' 'aarch64')
url="https://github.com/venom-cowork/workspace"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'libdrm' 'libxkbcommon' 'mesa' 'dbus' 'hicolor-icon-theme')
options=(!strip)

# Architecture-specific sources and checksums
source_x86_64=("${pkgname}-${pkgver}-x64.tar.gz::${url}/releases/download/v${pkgver}/venomcowork-linux-x64-${pkgver}.tar.gz")
sha256sums_x86_64=('b5126f5e1338990458d34636138b7c3832c61b5181ddd53cd5b10494a5c81e37')

source_aarch64=("${pkgname}-${pkgver}-arm64.tar.gz::${url}/releases/download/v${pkgver}/venomcowork-linux-arm64-${pkgver}.tar.gz")
sha256sums_aarch64=('432d2b28bdec019446d05fc14c2d9d492e7288e6d66382f9f86617f1e9f94063')

package() {
  cd "${srcdir}"

  local bundle_dir
  case "${CARCH}" in
    x86_64)
      bundle_dir="venomcowork-linux-x64-${pkgver}"
      ;;
    aarch64)
      bundle_dir="venomcowork-linux-arm64-${pkgver}"
      ;;
    *)
      echo "Unsupported architecture: ${CARCH}" >&2
      return 1
      ;;
  esac

  install -d "${pkgdir}/opt/venomcowork"
  cp -a "${bundle_dir}/." "${pkgdir}/opt/venomcowork/"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/venomcowork/@venomcoworkdesktop "${pkgdir}/usr/bin/venomcowork"

  install -Dm644 "${pkgdir}/opt/venomcowork/resources/app-dist/venomcowork-logo-square.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/venomcowork.svg"

  install -d "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/venomcowork.desktop" <<'EOF'
[Desktop Entry]
Name=VenomCowork
Comment=Run agents, skills, and MCP workflows
Exec=venomcowork %U
Terminal=false
Type=Application
Icon=venomcowork
StartupWMClass=VenomCowork
Categories=Development;Utility;
MimeType=x-scheme-handler/venomcowork;
EOF

  chmod 4755 "${pkgdir}/opt/venomcowork/chrome-sandbox"
}
